// Structs shared by the screens and the previews; Rust fills them (see src/history_view.rs).
// Slint resolves names in declaration order: each struct comes after the ones it uses.

/// Where the History refresh stands (see src/history_refresh.rs).
export enum RefreshState {
    /// Nothing running: History shows what was read last.
    idle,
    /// Reading the client's match history.
    reading,
    /// Waiting for the player to log into the client, to try again.
    waiting-for-login,
    /// The client failed to answer: waiting to try again.
    client-silent,
}

/// A stat behind an exercise, for its pictogram.
export enum StatKind {
    cs-per-minute,
    damage-share,
    kill-participation,
    vision-per-minute,
    deaths,
}

/// Where a judged stat stands against the role's benchmarks: `danger` at the floor or worse,
/// `warning` up to the average, `success` from the average on.
export enum StatZone {
    floor,
    below-average,
    average,
}

/// A stat of the Games view: its value, a gauge and the game's total.
export struct StatData {
    /// "8.5", "24 %".
    value: string,
    /// "269", "21.3k", "7/11".
    total: string,
    /// The formula judges this stat for the role: a benchmark gauge from the floor to the
    /// target, and the value in its zone's colour. A plain gauge in `text-primary` otherwise.
    judged: bool,
    zone: StatZone,
    /// Plain gauge: the filled part, 0 to 1.
    fill: float,
    /// Benchmark gauge: where the average sits, 0 (floor) to 1 (target).
    average: float,
    /// Benchmark gauge, shown while the row is hovered: "5.5" and "9.0".
    floor-label: string,
    target-label: string,
}

/// The cost curve of an exercise: the amount for every value of its stat. Positions run from
/// the floor (0) to the target (1), whichever way the stat goes.
export struct CostCurveData {
    /// Where the average sits.
    average: float,
    /// Where the game stands; below 0 under the floor, above 1 past the target.
    progress: float,
    /// The amount at the floor or worse, and at the average.
    max: int,
    mid: int,
    /// The game's amount before rounding, for the dot.
    amount: float,
    /// "18 %", "25 %", "31 %".
    floor-label: string,
    average-label: string,
    target-label: string,
    /// The benchmarks as numbers, to name the value under the pointer.
    floor: float,
    target: float,
    /// Decimals of a value: 1 for the per-minute stats, 0 otherwise.
    decimals: int,
    /// " %" for the shares, empty otherwise.
    suffix: string,
    /// "damage share", "CS per minute", "deaths".
    noun: string,
}

/// The structured tooltip of a cost curve's hover: the value under the pointer and what it
/// would cost (see `components/curve-tooltip.slint`).
export struct CurveTooltipData {
    /// "27 %", "4".
    value: string,
    /// "damage share", "deaths".
    noun: string,
    zone: StatZone,
    /// At the target or better: the exercise is waived.
    waived: bool,
    exercise-icon: image,
    /// "5", "15s".
    amount: string,
    /// "burpees", "burpee", "plank".
    unit: string,
    /// The amount minus the game's: its sign gives the chip's colour.
    difference: int,
    /// "−6 vs this game", "Same as this game".
    difference-label: string,
}

/// A tooltip to show: its content and the control it explains, in window coordinates (see
/// `tooltips.slint`).
export struct TooltipRequest {
    /// The text, and for a structured tooltip, what it says in a sentence.
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
    /// A cost curve's structured tooltip instead of the text.
    has-curve: bool,
    curve: CurveTooltipData,
}

/// One exercise of a game: the stat that pays for it and the amount due.
export struct ExerciseData {
    /// "BURPEES".
    name: string,
    stat: StatKind,
    /// "CS per minute", "Deaths".
    stat-label: string,
    /// "3.0", "19 %", "7".
    value: string,
    zone: StatZone,
    /// "/ 9.0", "/ 32 %", "/ 3".
    target: string,
    /// "−72 CS", "−9 pts", or empty on target and for the plank.
    gap: string,
    done: int,
    due: int,
    /// "s" for the plank, empty for repetitions.
    unit: string,
    /// "burpees", "squats", "plank", and "burpee", "squat", "plank" for one.
    unit-label: string,
    unit-label-one: string,
    /// The stat was at its floor or worse, the max applies: "max 15".
    capped: bool,
    cap-label: string,
    /// Never offered (games from before cooldown.lol).
    skipped: bool,
    curve: CostCurveData,
}

/// One game row of the History screen, for both views (Games and Workouts).
export struct GameRowData {
    /// The champion played; the initials stand in until the image is downloaded (ADR-0004).
    champion-image: image,
    has-champion-image: bool,
    champion-initials: string,
    champion-name: string,
    /// League's position symbol, hidden when the role is unknown.
    role-icon: image,
    has-role: bool,
    /// "Bottom", or "Role not detected".
    role-name: string,
    /// "Ranked Solo/Duo".
    queue: string,
    /// "WIN", "LOSS" or "REMAKE".
    result-label: string,
    win: bool,
    remake: bool,
    /// "34:12".
    length: string,
    /// When the game ended: "2h ago", and in full for its tooltip,
    /// "Sunday 1 November 2026, 20:35".
    played: string,
    played-at: string,
    kills: int,
    deaths: int,
    assists: int,
    /// "1.1 KDA".
    kda-ratio: string,
    /// The Games view's stats: CS per minute, damage share, kill participation, vision per
    /// minute. Empty when the game's stats could not be read.
    stats: [StatData],
    /// "SKIPPED" or "NO WORKOUT".
    status: string,
    has-workout: bool,
    /// Without workout only: "Remake", "Couldn't detect your role".
    reason: string,
    /// Burpees, squats, plank: the Workouts view's columns and the expanded details. Empty
    /// without workout.
    exercises: [ExerciseData],
}

/// A run of games with its header. `neutral` sessions (games from before cooldown.lol) have no
/// workout progress.
export struct SessionData {
    /// "TODAY · #1".
    label: string,
    /// "3 games · before cooldown.lol".
    subtitle: string,
    neutral: bool,
    wins: int,
    losses: int,
    games: [GameRowData],
}
