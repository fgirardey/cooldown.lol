// THROWAWAY debug screen: buttons that fire events to test the integration
// (error reports). Pushed from Settings, in debug builds only; its title and the way back are
// in the top bar. No Pencil frame.
// Delete it with `Screen.debug`, `Route::Debug`, its layer in app-window.slint and the Rust handler.

import { Theme } from "../theme.slint";
import { PrimaryButton } from "../components/primary-button.slint";

export component DebugScreen inherits VerticalLayout {
    /// `kind` is one of "warning", "error", "scrubbed-error", "panic".
    callback fire(kind: string);

    padding: Theme.space-l;
    spacing: Theme.space-m;
    alignment: start;

    PrimaryButton {
        text: "Log a warning";
        clicked => { root.fire("warning"); }
    }

    PrimaryButton {
        text: "Log an error";
        clicked => { root.fire("error"); }
    }

    PrimaryButton {
        text: "Log an error with personal data";
        clicked => { root.fire("scrubbed-error"); }
    }

    PrimaryButton {
        text: "Panic (in a thread)";
        clicked => { root.fire("panic"); }
    }

    Text {
        font-family: Theme.font-body;
        text: "Reaches Sentry only if crash reports were on at launch and COOLDOWN_SENTRY_DSN is set. Errors are sent at most once a minute. The personal data one must arrive scrubbed.";
        color: Theme.text-secondary;
        font-size: Theme.font-size-caption;
        wrap: word-wrap;
    }
}
