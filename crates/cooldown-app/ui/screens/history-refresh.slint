// The History refresh, at the right end of the title row: when History was last read from the
// League client, and a button to read it again now. Its tooltip always says why the button is
// in its state.
//
// Frames in design/cooldown.pen: `History refresh`, `History refresh / Updating`,
// `History refresh / Offline`, `History refresh / Hover` and `History refresh / Tooltip / *`
// (History components).

import { Theme } from "../theme.slint";
import { RefreshState } from "../models.slint";
import { Icon } from "../components/icon.slint";
import { StateLayer } from "../components/state-layer.slint";
import { TooltipAnchor } from "../components/tooltip-anchor.slint";

export component HistoryRefresh inherits HorizontalLayout {
    /// "Updated 2 min ago"; empty before the first read.
    in property <string> updated;
    /// Where a read stands: anything but `idle` shows "Updating…" and disables the button.
    in property <RefreshState> state: RefreshState.idle;
    /// The client is there to read from.
    in property <bool> enabled: true;
    callback clicked;

    property <bool> busy: root.state != RefreshState.idle;
    property <bool> can-click: root.enabled && !root.busy;
    property <string> reason: !root.enabled
        ? "Open the League client to refresh History."
        : root.state == RefreshState.reading
        ? "Reading your latest games from the League client…"
        : root.state == RefreshState.waiting-for-login
        ? "Waiting for you to log in to the League client. Trying again every 10 s."
        : root.state == RefreshState.client-silent
        ? "The League client isn't answering. Trying again every 10 s."
        : "Read your latest games from the League client now. History also updates on its own after each game.";

    alignment: end;

    HorizontalLayout {
        spacing: Theme.space-s;

        if root.busy || root.updated != "": Text {
            font-family: Theme.font-body;
            text: root.busy ? "Updating…" : root.updated;
            color: Theme.text-secondary;
            font-size: Theme.font-size-caption;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;

            // Around the faded button, so the reason shows when it is disabled too.
            TooltipAnchor {
                width: 32px;
                height: 32px;
                tooltip: root.reason;

                button := Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-m;
                    opacity: root.can-click ? 1 : Theme.disabled-opacity;
                    transform-scale: touch.pressed ? Theme.press-scale : 1;
                    animate transform-scale {
                        duration: Theme.motion-fast;
                        easing: ease-out;
                    }

                    StateLayer {
                        border-radius: parent.border-radius;
                        tint: Theme.text-primary;
                        hovered: touch.has-hover;
                        pressed: touch.pressed;
                    }

                    Icon {
                        source: @image-url("../images/icons/refresh-cw.svg");
                        width: 16px;
                        height: 16px;
                        colorize: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        animate colorize {
                            duration: Theme.motion-fast;
                            easing: ease-out;
                        }
                    }

                    touch := TouchArea {
                        enabled: root.can-click;
                        mouse-cursor: root.can-click ? pointer : default;
                        clicked => { root.clicked(); }
                    }
                }
            }
        }
    }
}
