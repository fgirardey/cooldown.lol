// Previews of CurveTooltip: `just preview components/curve-tooltip`. In the app, hover a cost
// curve (`just preview components/cost-curve`, then the gallery's last case).

import { Theme } from "../theme.slint";
import { CurveTooltip } from "curve-tooltip.slint";
import { StatZone } from "../models.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";
import { PreviewPlayground } from "../preview-kit/preview-playground.slint";

// Pencil frame `Game row / Details / Exercise / Tooltip`.
export component GameRowDetailsExerciseTooltip inherits Rectangle {
    width: 264px;
    height: tooltip.height + Theme.tooltip-pointer;
    background: Theme.background;

    // Room above for the pointer, aimed at a marker on the left.
    tooltip := CurveTooltip {
        y: Theme.tooltip-pointer;
        pointer-x: 90px;
        data: {
            value: "27 %",
            noun: "damage share",
            zone: StatZone.average,
            waived: false,
            exercise-icon: @image-url("../images/icons/burpee.svg"),
            amount: "5",
            unit: "burpees",
            difference: -6,
            difference-label: "−6 vs this game",
        };
    }
}

// Pencil frame `Game row / Details / Exercise / Tooltip / This game`.
export component GameRowDetailsExerciseTooltipThisGame inherits Rectangle {
    width: 264px;
    height: tooltip.height + Theme.tooltip-pointer;
    background: Theme.background;

    // Room above for the pointer, aimed at the game's dot.
    tooltip := CurveTooltip {
        y: Theme.tooltip-pointer;
        pointer-x: 132px;
        data: {
            value: "22 %",
            noun: "damage share",
            zone: StatZone.below-average,
            exercise-icon: @image-url("../images/icons/burpee.svg"),
            amount: "11",
            unit: "burpees",
            this-game: true,
            status: "0/11 · skipped",
            status-color: Theme.text-secondary,
            target-gap: "−9 pts to target 31 %",
        };
    }
}

