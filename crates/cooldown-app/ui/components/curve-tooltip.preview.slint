// Edit the knobs in the live preview's Data tab.
export component CurveTooltipPlayground inherits Window {
    in-out property <string> value: "27 %";
    in-out property <string> noun: "damage share";
    in-out property <StatZone> zone: StatZone.average;
    in-out property <bool> waived;
    in-out property <string> amount: "5";
    in-out property <string> unit: "burpees";
    in-out property <int> difference: -6;
    in-out property <string> difference-label: "−6 vs this game";

    background: Theme.background;
    preferred-width: 320px;

    PreviewPlayground {
        HorizontalLayout {
            alignment: start;

            CurveTooltip {
                data: {
                    value: root.value,
                    noun: root.noun,
                    zone: root.zone,
                    waived: root.waived,
                    exercise-icon: @image-url("../images/icons/burpee.svg"),
                    amount: root.amount,
                    unit: root.unit,
                    difference: root.difference,
                    difference-label: root.difference-label,
                };
            }
        }
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "CurveTooltip";
    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "Fewer than the game, average or better";
            GameRowDetailsExerciseTooltip { }
        }

        PreviewCase {
            label: "This game (on its dot): status and gap to target";
            GameRowDetailsExerciseTooltipThisGame { }
        }

        PreviewCase {
            label: "This game, complete and on target";
            CurveTooltip {
                data: {
                    value: "33 %",
                    noun: "damage share",
                    zone: StatZone.average,
                    waived: true,
                    exercise-icon: @image-url("../images/icons/squat.svg"),
                    amount: "0",
                    unit: "squats",
                    this-game: true,
                    status: "0/0 · complete",
                    status-color: Theme.success,
                };
            }
        }

        PreviewCase {
            label: "More than the game, at the floor or worse";
            GameRowDetailsExerciseTooltipMore { }
        }

        PreviewCase {
            label: "Same as the game, below average";
            GameRowDetailsExerciseTooltipSame { }
        }

        PreviewCase {
            label: "Target reached: waived";
            GameRowDetailsExerciseTooltipWaived { }
        }

        PreviewCase {
            label: "Plank (deaths)";
            GameRowDetailsExerciseTooltipPlank { }
        }

        PreviewCase {
            label: "One squat";
            CurveTooltip {
                data: {
                    value: "7.9",
                    noun: "CS per minute",
                    zone: StatZone.average,
                    exercise-icon: @image-url("../images/icons/squat.svg"),
                    amount: "1",
                    unit: "squat",
                    difference: -25,
                    difference-label: "−25 vs this game",
                };
            }
        }
    }
}
