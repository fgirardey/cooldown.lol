// The panel of a tooltip, around its content (`TooltipText` puts a text in it): a raised panel
// with a pointer on its edge aimed at the control. The window's `TooltipLayer` draws it and
// places the pointer; controls ask for it with `TooltipAnchor`.
//
// `Tooltip` component of `History components` in design/cooldown.pen.

import { Theme } from "../theme.slint";
import { TooltipSurface } from "tooltip-surface.slint";

export component TooltipPanel inherits Rectangle {
    /// Content wider than this is squeezed to it: text wraps.
    in property <length> max-content-width: Theme.tooltip-max-width;
    /// Padding on each side of the content.
    out property <length> horizontal-padding: 10px;
    /// The pointer: on the top edge (the tooltip is under its control) or the bottom one,
    /// centred on `pointer-x` from the left edge, kept off the corners.
    in property <bool> pointer-up: true;
    in property <length> pointer-x: root.width / 2;

    // A wrapping text prefers its unwrapped line: size the panel to the squeezed content.
    property <length> panel-width: min(content.preferred-width, root.max-content-width + 2 * root.horizontal-padding);

    width: root.panel-width;
    preferred-width: root.panel-width;
    height: content.preferred-height;
    preferred-height: content.preferred-height;

    // The raised panel and its pointer, behind the content.
    TooltipSurface {
        x: 0px;
        y: -Theme.tooltip-pointer;
        panel-width: root.width;
        panel-height: root.height;
        up: root.pointer-up;
        pointer-x: root.pointer-x;
    }

    content := VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: root.horizontal-padding;
        padding-right: root.horizontal-padding;
        spacing: 2px;

        @children
    }
}
