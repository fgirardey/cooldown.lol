// The game part of a History row: the champion portrait, then
// - Games view: the result, the length and when the game was played ("2h ago", the exact date
//   and time in a tooltip), and the queue under them;
// - Workouts view: the champion's name, the role, and the result with the K/D/A and the length.
//
// `Game` of the `Game row / *` components in design/cooldown.pen, played time's tooltip in
// `Game row / Played / Tooltip`. The linked champion of the portrait is not shown yet
// (docs/Product/Champion portraits.md): its space stays empty.

import { Theme } from "../theme.slint";
import { GameRowData } from "../models.slint";
import { ChampionPortrait } from "champion-portrait.slint";
import { TooltipAnchor } from "tooltip-anchor.slint";

export component GameSummary inherits HorizontalLayout {
    in property <GameRowData> game;
    /// Workouts view: the champion's name and the role instead of the queue.
    in property <bool> workouts;

    property <color> result-color: root.game.remake ? Theme.text-secondary
        : root.game.win ? Theme.info
        : Theme.danger;

    width: root.workouts ? 220px : 252px;
    spacing: 12px;
    alignment: start;

    Rectangle {
        width: 76px;
        height: 54px;
        y: (parent.height - self.height) / 2;

        ChampionPortrait {
            x: 0px;
            y: 0px;
            image: root.game.champion-image;
            has-image: root.game.has-champion-image;
            initials: root.game.champion-initials;
            role-icon: root.game.role-icon;
            has-role: root.game.has-role;
            role-name: root.game.role-name;
        }
    }

    if !root.workouts: VerticalLayout {
        spacing: 6px;
        alignment: center;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                font-family: Theme.font-display;
                text: root.game.result-label;
                color: root.result-color;
                font-size: Theme.font-size-result;
                font-weight: 800;
                font-italic: true;
                vertical-alignment: bottom;
            }

            Text {
                font-family: Theme.font-body;
                text: root.game.length;
                color: Theme.text-primary;
                font-size: Theme.font-size-label;
                font-weight: 600;
                vertical-alignment: bottom;
            }

            Text {
                font-family: Theme.font-body;
                text: "·";
                color: Theme.text-secondary;
                font-size: Theme.font-size-caption;
                vertical-alignment: bottom;
            }

            TooltipAnchor {
                tooltip: root.game.played-at;

                Text {
                    height: parent.height;
                    font-family: Theme.font-body;
                    text: root.game.played;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-caption;
                    vertical-alignment: bottom;
                }
            }
        }

        Text {
            font-family: Theme.font-body;
            text: root.game.queue;
            color: Theme.text-primary;
            font-size: Theme.font-size-label;
            font-weight: 500;
            overflow: elide;
        }
    }

    if root.workouts: VerticalLayout {
        spacing: 1px;
        alignment: center;

        Text {
            font-family: Theme.font-body;
            text: root.game.champion-name;
            color: Theme.text-primary;
            font-size: Theme.font-size-body;
            font-weight: 600;
            overflow: elide;
        }

        Text {
            font-family: Theme.font-body;
            text: root.game.role-name;
            color: Theme.text-secondary;
            font-size: Theme.font-size-caption;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                font-family: Theme.font-display;
                text: root.game.result-label;
                color: root.result-color;
                font-size: Theme.font-size-body;
                font-weight: 800;
                font-italic: true;
                vertical-alignment: center;
            }

            Text {
                font-family: Theme.font-body;
                text: root.game.kills + "/" + root.game.deaths + "/" + root.game.assists + " · " + root.game.length;
                color: Theme.text-secondary;
                font-size: Theme.font-size-caption;
                vertical-alignment: center;
            }
        }
    }
}
