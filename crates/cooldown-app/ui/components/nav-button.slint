// Square icon button of the top bar (Settings, About). Marked while its screen is shown,
// tinted on hover and pressed; its tooltip names it, since it has no label.
//
// Frames in design/cooldown.pen: `Nav / Settings` and `Nav / About` in `App shell / Top bar / Default`,
// tooltips in `Top bar / Tooltip / *` (History components).

import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { StateLayer } from "state-layer.slint";
import { TooltipAnchor } from "tooltip-anchor.slint";

export component NavButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    /// What the button opens: "Settings".
    in property <string> tooltip;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: Theme.radius-m;
    background: root.active ? Theme.border : transparent;

    TooltipAnchor {
        tooltip: root.tooltip;

        StateLayer {
            border-radius: root.border-radius;
            tint: Theme.text-primary;
            hovered: touch.has-hover;
            pressed: touch.pressed;
        }

        Icon {
            source: root.icon;
            width: 22px;
            height: 22px;
            colorize: root.active || touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            animate colorize {
                duration: Theme.motion-fast;
                easing: ease-out;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}
