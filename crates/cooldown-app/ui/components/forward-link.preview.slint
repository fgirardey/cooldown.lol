// Previews of ForwardLink: `just preview components/forward-link`.

import { Theme } from "../theme.slint";
import { ForwardLink } from "forward-link.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";
import { PreviewPlayground } from "../preview-kit/preview-playground.slint";

// Edit the knobs in the live preview's Data tab; clicks show as the last action.
export component ForwardLinkPlayground inherits Window {
    in-out property <string> text: "Debug events";

    background: Theme.background;
    preferred-width: 360px;

    playground := PreviewPlayground {
        HorizontalLayout {
            alignment: start;
            ForwardLink {
                text: root.text;
                clicked => { playground.log("clicked"); }
            }
        }
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "ForwardLink";
    background: Theme.background;
    preferred-width: 360px;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "Default";
            HorizontalLayout {
                alignment: start;
                ForwardLink { text: "Debug events"; }
            }
        }
        PreviewCase {
            label: "Long text";
            HorizontalLayout {
                alignment: start;
                ForwardLink { text: "Open the next screen with a long name"; }
            }
        }
    }
}
