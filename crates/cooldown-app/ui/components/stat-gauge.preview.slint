// Previews of StatGauge: `just preview components/stat-gauge`.

import { Theme } from "../theme.slint";
import { StatGauge } from "stat-gauge.slint";
import { StatKind } from "../models.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";

// `Stat · CS per minute` of `Game row / Games / Skipped`: at the floor or worse.
export component StatGaugeFloor inherits Rectangle {
    width: 136px;
    height: 40px;
    background: Theme.surface;

    StatGauge {
        kind: StatKind.cs-per-minute;
        stat: Fixtures.game-jinx.stats[0];
        caption: "CS per minute";
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "StatGauge";
    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-l;
        alignment: start;

        PreviewCase {
            label: "At the floor or worse";
            StatGaugeFloor { }
        }

        PreviewCase {
            label: "Below the average";
            StatGauge {
                kind: StatKind.damage-share;
                stat: Fixtures.game-miss-fortune.stats[1];
                caption: "Damage share";
            }
        }

        PreviewCase {
            label: "The average or better";
            StatGauge {
                kind: StatKind.cs-per-minute;
                stat: Fixtures.game-miss-fortune.stats[0];
                caption: "CS per minute";
            }
        }

        PreviewCase {
            label: "Row hovered: the scale (Game row / Games / Hover)";
            StatGauge {
                kind: StatKind.cs-per-minute;
                stat: Fixtures.game-miss-fortune.stats[0];
                caption: "CS per minute";
                row-hovered: true;
            }
        }

        PreviewCase {
            label: "Not judged for the role: plain gauge";
            StatGauge {
                kind: StatKind.kill-participation;
                stat: Fixtures.game-miss-fortune.stats[2];
                caption: "Kill participation";
            }
        }

        PreviewCase {
            label: "Stats unreadable";
            StatGauge {
                kind: StatKind.vision-per-minute;
                known: false;
                caption: "Vision per minute";
            }
        }
    }
}
