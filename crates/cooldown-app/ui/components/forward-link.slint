// "<text> ›" link to a screen pushed over the current one (docs/Product/Screens.md,
// Navigation: only Back points left). Brightens on hover and dims while pressed.
//
// Text link of the `Controls library` in design/cooldown.pen, with the chevron after the text.

import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";

export component ForwardLink inherits TouchArea {
    in property <string> text;
    property <color> content: root.has-hover ? Theme.text-primary : Theme.text-secondary;

    mouse-cursor: pointer;
    opacity: root.pressed ? 0.6 : 1;
    animate opacity {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    HorizontalLayout {
        spacing: Theme.space-xs;
        Text {
            font-family: Theme.font-body;
            text: root.text;
            color: root.content;
            font-size: Theme.font-size-body;
            animate color {
                duration: Theme.motion-fast;
                easing: ease-out;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../images/icons/chevron-right.svg");
                width: 6px;
                height: 10px;
                colorize: root.content;
                animate colorize {
                    duration: Theme.motion-fast;
                    easing: ease-out;
                }
            }
        }
    }
}
