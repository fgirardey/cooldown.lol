// Previews of ChampionPortrait: `just preview components/champion-portrait`.

import { Theme } from "../theme.slint";
import { ChampionPortrait } from "champion-portrait.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";
import { TooltipLayer } from "../shell/tooltip-layer.slint";

// Pencil frame `Champion portrait` (played champion only).
export component ChampionPortraitStory inherits Rectangle {
    width: 76px;
    height: 54px;
    background: Theme.surface;

    ChampionPortrait {
        x: 0px;
        image: Fixtures.game-jinx.champion-image;
        has-image: true;
        initials: "JI";
        role-icon: Fixtures.game-jinx.role-icon;
        has-role: true;
    }
}

// The role badge's tooltip, held open since a story cannot hover.
// Pencil frame `Champion portrait / Tooltip / Role`.
export component ChampionPortraitTooltipRole inherits Rectangle {
    width: 120px;
    height: 111px;
    background: Theme.background;

    portrait := ChampionPortrait {
        x: 40px;
        y: 12px;
        image: Fixtures.game-jinx.champion-image;
        has-image: true;
        initials: "JI";
        role-icon: Fixtures.game-jinx.role-icon;
        has-role: true;
        role-name: Fixtures.game-jinx.role-name;
    }

    TooltipLayer {
        always-open: true;
        // The badge, in the portrait's bottom-left corner.
        request: {
            text: Fixtures.game-jinx.role-name,
            x: portrait.x,
            y: portrait.y + 36px,
            width: 18px,
            height: 18px,
        };
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "ChampionPortrait";
    background: Theme.background;

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "With image";
            ChampionPortraitStory { }
        }

        PreviewCase {
            label: "Image not downloaded: initials";
            ChampionPortrait {
                has-image: false;
                initials: "AH";
                role-icon: Fixtures.game-ahri-no-image.role-icon;
                has-role: true;
            }
        }

        PreviewCase {
            label: "Role unknown";
            ChampionPortrait {
                image: Fixtures.game-no-role.champion-image;
                has-image: true;
                has-role: false;
            }
        }

        PreviewCase {
            label: "Champion portrait / Tooltip / Role";
            ChampionPortraitTooltipRole { }
        }
    }
}
